# Salin ke .env dan sesuaikan. Dipakai oleh Nest (ConfigModule) dan Prisma CLI saat dijalankan dari folder backend.

# --- PostgreSQL (wajib salah satu) ---
# Opsi A: DATABASE_URL (mengoverride PSQL_*).
# DATABASE_URL=postgresql://wms:CHANGE_ME@your-db-host.example.com:5432/wms?schema=public
# Opsi B: PSQL_* — DATABASE_URL disusun otomatis (?schema=public).
PSQL_NAME=wms
PSQL_USER=wms
PSQL_PASSWORD=CHANGE_ME
PSQL_HOST=127.0.0.1
PSQL_PORT=5432

JWT_SECRET=change-me-minimum-sixteen-characters
JWT_EXPIRES_IN=1d
API_PORT=4000

# Opsional: REDIS_URL mengoverride REDIS_HOST/PORT/PASSWORD/DB. docker-compose meng-set REDIS_URL ke redis://redis:6379.
# REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
RABBITMQ_URL=amqp://wms:wms@localhost:5672
RABBITMQ_QUEUE=wms_queue
RABBITMQ_PUBLISH_QUEUE=wms_events
RABBITMQ_PREFETCH=10

CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# S3 uploads (opsional)
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# S3_ENDPOINT=http://localhost:9000

# Integration webhooks (opsional)
INTEGRATION_WEBHOOK_SECRET=
