# Salin ke .env dan sesuaikan. Dipakai oleh Nest (ConfigModule) dan Prisma CLI saat dijalankan dari folder backend.

# --- PostgreSQL (wajib salah satu) ---
# Opsi A: DATABASE_URL (mengoverride PSQL_*). Jangan tambahkan ?schema= — routing tenant memakai PostgreSQL search_path.
# DATABASE_URL=postgresql://wms:CHANGE_ME@your-db-host.example.com:5432/wms
# Opsi B: PSQL_* — DATABASE_URL disusun otomatis tanpa ?schema=.
PSQL_NAME=wms
PSQL_USER=wms
PSQL_PASSWORD=CHANGE_ME
PSQL_HOST=127.0.0.1
PSQL_PORT=5432

JWT_SECRET=change-me-minimum-sixteen-characters
JWT_EXPIRES_IN=1d
API_PORT=4000

# Opsional: REDIS_URL mengoverride REDIS_HOST/PORT/PASSWORD/DB. docker-compose meng-set REDIS_URL ke redis://redis:6379.
# REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
RABBITMQ_URL=amqp://wms:wms@localhost:5672
RABBITMQ_QUEUE=wms_queue
RABBITMQ_PUBLISH_QUEUE=wms_events
RABBITMQ_PREFETCH=10

CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# S3 uploads (opsional)
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# S3_ENDPOINT=http://localhost:9000

# Integration webhooks (opsional)
INTEGRATION_WEBHOOK_SECRET=
INTEGRATION_ALERT_WEBHOOK_URL=

# --- Flyway (SaaS schema-per-tenant, fase S1+) ---
# DDL via Flyway; Prisma hanya untuk ORM (prisma:generate).
# Runner: auto = flyway CLI jika ada, else Docker image flyway/flyway
# FLYWAY_RUNNER=auto
# FLYWAY_RUNNER=docker
# FLYWAY_RUNNER=local   # disarankan di image Docker backend (Flyway CLI terpasang)
# Lewati migrate saat startup container (debug saja)
# SKIP_DB_MIGRATE=false
# Tunggu DB sebelum migrate (Docker entrypoint)
# WAIT_FOR_DB=true
# DB_WAIT_MAX_ATTEMPTS=30
# DB_WAIT_DELAY_MS=2000
# Host DB dari dalam container Flyway (dev lokal Windows/macOS)
# FLYWAY_DOCKER_HOST=host.docker.internal
# FLYWAY_DOCKER_NETWORK=wms-platform_default
# Schema tenant dev untuk migrate lokal (comma-separated untuk banyak tenant)
FLYWAY_DEV_TENANT_SCHEMA=tenant_default
# FLYWAY_TENANT_SCHEMAS=tenant_default,tenant_demo

# Wajib di dev SaaS agar request tanpa tenant tidak jatuh ke schema public.
SAAS_TENANT_REQUIRED=true
# SEED_PLATFORM_ADMIN_EMAIL=platform@wms.local
# SEED_PLATFORM_ADMIN_PASSWORD=password123
# SEED_PLATFORM_ADMIN_NAME=Platform Super Admin
# SEED_DEV_TENANT_SLUG=default
# SEED_DEV_TENANT_NAME=Default Dev Tenant

# Seed / provision tenant schema (fase S3)
# SEED_ADMIN_EMAIL=admin@tenant.local
# SEED_ADMIN_PASSWORD=password123
# SEED_ADMIN_NAME=Tenant Admin

# Tenant context (fase S4) — resolve schema per request
# SAAS_TENANT_REQUIRED=false
TENANT_DEFAULT_SLUG=default
# TENANT_BASE_DOMAIN=wms.app

# Platform admin JWT (fase S5) — terpisah dari tenant JWT
# PLATFORM_JWT_SECRET=change-me-platform-jwt-secret-min-16
# PLATFORM_JWT_EXPIRES_IN=8h
# PLATFORM_IMPERSONATION_EXPIRES_IN=15m

# Tenant signup publik (fase S6)
# TENANT_SIGNUP_ENABLED=true
SIGNUP_DEFAULT_PLAN_CODE=STARTER
# AUTH_ALLOW_OPEN_REGISTER=false
