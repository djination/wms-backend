generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String?
  operatorCompanyId String? @map("operator_company_id")
  isActive     Boolean  @default(true) @map("is_active")
  canAccessWeb Boolean  @default(true) @map("can_access_web")
  canAccessMobile Boolean @default(false) @map("can_access_mobile")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  operatorCompany OperatorCompany? @relation(fields: [operatorCompanyId], references: [id])
  userRoles    UserRole[]
  warehouseMappings UserWarehouse[]

  @@index([isActive])
  @@index([operatorCompanyId])
  @@map("users")
}

enum RoleScope {
  SYSTEM
  OPERATIONAL
}

model Role {
  id          String     @id @default(uuid())
  code        String     @unique
  name        String
  scope       RoleScope  @default(OPERATIONAL)
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  userRoles   UserRole[]
  roleMenus   RoleMenu[]

  @@index([isActive])
  @@map("roles")
}

model Menu {
  id          String     @id @default(uuid())
  code        String     @unique
  name        String
  path        String?
  icon        String?
  sortOrder   Int        @default(0) @map("sort_order")
  parentId    String?    @map("parent_id")
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  parent      Menu?      @relation("MenuHierarchy", fields: [parentId], references: [id])
  children    Menu[]     @relation("MenuHierarchy")
  roleMenus   RoleMenu[]

  @@index([parentId, sortOrder])
  @@index([isActive])
  @@map("menus")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])
  role      Role     @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RoleMenu {
  id        String   @id @default(uuid())
  roleId    String   @map("role_id")
  menuId    String   @map("menu_id")
  createdAt DateTime @default(now()) @map("created_at")
  role      Role     @relation(fields: [roleId], references: [id])
  menu      Menu     @relation(fields: [menuId], references: [id])

  @@unique([roleId, menuId])
  @@index([menuId])
  @@map("role_menus")
}

enum CustomerType {
  SHARED
  DEDICATED
}

enum WarehouseType {
  SHARED
  DEDICATED
}

enum InboundAsnStatus {
  DRAFT
  RECEIVING
  COMPLETED
  CANCELLED
}

enum SalesOrderStatus {
  DRAFT
  RELEASED
  ALLOCATED
  PICKING
  PACKING
  LOADING
  SHIPPED
  CANCELLED
}

enum OutboundTaskType {
  PICKING
  PACKING
  LOADING
}

enum OutboundTaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum OutboundSerialReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
}

enum BillingComponent {
  STORAGE
  HANDLING
  VAS
  DEDICATED_RESOURCE
  FIXED_FEE
}

enum BillingTransactionStatus {
  DRAFT
  POSTED
}

enum InternalTransferStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

enum MaterialTransformationStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

model Customer {
  id          String       @id @default(uuid())
  code        String       @unique
  name        String
  type        CustomerType @default(SHARED)
  phone       String?      @map("phone")
  address     String?      @map("address") @db.Text
  province    String?      @map("province")
  city        String?      @map("city")
  district    String?      @map("district")
  subdistrict String?      @map("subdistrict")
  postalCode  String?      @map("postal_code")
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  warehouses  Warehouse[]
  warehouseMappings WarehouseCustomer[]
  products    Product[]
  suppliers   Supplier[]
  inventories InventoryBalance[]
  inboundAsns InboundAsn[]
  inboundReceipts InboundReceipt[]
  billingContracts BillingContract[]
  billingTransactions BillingTransaction[]
  salesOrders SalesOrder[]
  outboundAllocations OutboundAllocation[]
  outboundSerialReservations OutboundSerialReservation[]
  outboundEvents OutboundEventLog[]
  processFlowEvents ProcessFlowEventLog[]
  internalTransfers InternalTransfer[]
  materialTransformations MaterialTransformation[]
  recipes      ProcessRecipe[]
  pics        CustomerPic[]

  @@index([isActive])
  @@map("customers")
}

model OperatorCompany {
  id                  String      @id @default(uuid())
  code                String      @unique
  name                String
  phone               String?     @map("phone")
  address             String?     @map("address") @db.Text
  province            String?     @map("province")
  city                String?     @map("city")
  district            String?     @map("district")
  subdistrict         String?     @map("subdistrict")
  postalCode          String?     @map("postal_code")
  isActive            Boolean     @default(true) @map("is_active")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")
  ownedWarehouses     Warehouse[] @relation("WarehouseOwner")
  operatedWarehouses  Warehouse[] @relation("WarehouseOperator")
  billingTransactions BillingTransaction[]
  outboundEvents OutboundEventLog[]
  processFlowEvents ProcessFlowEventLog[]
  pics                OperatorCompanyPic[]
  users               User[]

  @@index([isActive])
  @@map("operator_companies")
}

model Warehouse {
  id                String          @id @default(uuid())
  code              String          @unique
  name              String
  type              WarehouseType   @default(SHARED)
  phone             String?         @map("phone")
  address           String?         @map("address") @db.Text
  province          String?         @map("province")
  city              String?         @map("city")
  district          String?         @map("district")
  subdistrict       String?         @map("subdistrict")
  postalCode        String?         @map("postal_code")
  isActive          Boolean         @default(true) @map("is_active")
  customerId        String?         @map("customer_id")
  ownerCompanyId    String          @map("owner_company_id")
  operatorCompanyId String?         @map("operator_company_id")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  customer          Customer?       @relation(fields: [customerId], references: [id])
  customerMappings  WarehouseCustomer[]
  ownerCompany      OperatorCompany @relation("WarehouseOwner", fields: [ownerCompanyId], references: [id])
  operatorCompany   OperatorCompany? @relation("WarehouseOperator", fields: [operatorCompanyId], references: [id])
  areas             WarehouseArea[]
  zones             WarehouseZone[]
  bins              WarehouseBin[]
  inventories       InventoryBalance[]
  inboundAsns       InboundAsn[]
  inboundReceipts   InboundReceipt[]
  billingTransactions BillingTransaction[]
  salesOrders       SalesOrder[]
  outboundWaves     OutboundWave[]
  outboundTasks     OutboundTask[]
  outboundAllocations OutboundAllocation[]
  outboundSerialReservations OutboundSerialReservation[]
  outboundEvents    OutboundEventLog[]
  processFlowEvents ProcessFlowEventLog[]
  transfersFrom     InternalTransfer[] @relation("TransferFromWarehouse")
  transfersTo       InternalTransfer[] @relation("TransferToWarehouse")
  transformations   MaterialTransformation[]
  userMappings      UserWarehouse[]

  @@index([customerId])
  @@index([ownerCompanyId])
  @@index([operatorCompanyId])
  @@index([isActive])
  @@map("warehouses")
}

model UserWarehouse {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  warehouseId String   @map("warehouse_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([userId, warehouseId])
  @@index([warehouseId])
  @@map("user_warehouses")
}

model CustomerPic {
  id         String   @id @default(uuid())
  customerId String   @map("customer_id")
  name       String
  phone      String?  @map("phone")
  email      String?  @map("email")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, sortOrder])
  @@map("customer_pics")
}

model OperatorCompanyPic {
  id                String          @id @default(uuid())
  operatorCompanyId String          @map("operator_company_id")
  name              String
  phone             String?         @map("phone")
  email             String?         @map("email")
  sortOrder         Int             @default(0) @map("sort_order")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  operatorCompany   OperatorCompany @relation(fields: [operatorCompanyId], references: [id], onDelete: Cascade)

  @@index([operatorCompanyId, sortOrder])
  @@map("operator_company_pics")
}

model WarehouseCustomer {
  id          String    @id @default(uuid())
  warehouseId String    @map("warehouse_id")
  customerId  String    @map("customer_id")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  customer    Customer  @relation(fields: [customerId], references: [id])

  @@unique([warehouseId, customerId])
  @@index([warehouseId, isActive])
  @@index([customerId, isActive])
  @@map("warehouse_customers")
}

model WarehouseArea {
  id          String          @id @default(uuid())
  warehouseId String          @map("warehouse_id")
  code        String
  name        String
  isActive    Boolean         @default(true) @map("is_active")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  warehouse   Warehouse       @relation(fields: [warehouseId], references: [id])
  zones       WarehouseZone[]

  @@unique([warehouseId, code])
  @@index([warehouseId, isActive])
  @@map("warehouse_areas")
}

model WarehouseZone {
  id          String          @id @default(uuid())
  warehouseId String          @map("warehouse_id")
  areaId      String?         @map("area_id")
  code        String
  name        String
  isActive    Boolean         @default(true) @map("is_active")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  warehouse   Warehouse       @relation(fields: [warehouseId], references: [id])
  area        WarehouseArea?  @relation(fields: [areaId], references: [id])
  bins        WarehouseBin[]

  @@unique([warehouseId, code])
  @@index([areaId])
  @@index([warehouseId, isActive])
  @@map("warehouse_zones")
}

model WarehouseBin {
  id          String            @id @default(uuid())
  warehouseId String            @map("warehouse_id")
  zoneId      String            @map("zone_id")
  code        String
  name        String
  isActive    Boolean           @default(true) @map("is_active")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  warehouse   Warehouse         @relation(fields: [warehouseId], references: [id])
  zone        WarehouseZone     @relation(fields: [zoneId], references: [id])
  inventories InventoryBalance[]
  inboundReceipts InboundReceipt[]
  outboundTasks OutboundTask[] @relation("OutboundSourceBin")
  outboundAllocations OutboundAllocation[]
  transferSourceLines InternalTransferLine[] @relation("TransferLineSourceBin")
  transferDestinationLines InternalTransferLine[] @relation("TransferLineDestinationBin")
  transformationInputs MaterialTransformationInput[]
  transformationOutputs MaterialTransformation[] @relation("TransformationOutputBin")

  @@unique([warehouseId, code])
  @@index([zoneId])
  @@index([warehouseId, isActive])
  @@map("warehouse_bins")
}

model Product {
  id          String            @id @default(uuid())
  customerId  String            @map("customer_id")
  baseUomId   String?           @map("base_uom_id")
  sku         String
  name        String
  isActive    Boolean           @default(true) @map("is_active")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  customer    Customer          @relation(fields: [customerId], references: [id])
  baseUom     UnitOfMeasure?    @relation("ProductBaseUom", fields: [baseUomId], references: [id])
  inventories InventoryBalance[]
  inboundItems InboundAsnItem[]
  inboundReceipts InboundReceipt[]
  salesOrderItems SalesOrderItem[]
  outboundTasks OutboundTask[]
  outboundAllocations OutboundAllocation[]
  outboundSerialReservations OutboundSerialReservation[]
  transferLines InternalTransferLine[]
  transformationInputs MaterialTransformationInput[]
  transformationOutputs MaterialTransformation[] @relation("TransformationOutputProduct")
  recipeLines ProcessRecipeLine[]
  recipeHeaders ProcessRecipe[] @relation("RecipeOutputProduct")
  supplierMappings ProductSupplier[]
  uomConversions ProductUomConversion[]

  @@unique([customerId, sku])
  @@index([customerId, isActive])
  @@index([baseUomId])
  @@map("products")
}

model UnitOfMeasure {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  inboundAsnItems InboundAsnItem[]
  inboundReceipts InboundReceipt[]
  baseForProducts Product[] @relation("ProductBaseUom")
  transferLines InternalTransferLine[]
  conversionFrom ProductUomConversion[] @relation("ProductUomConversionFromUom")
  conversionTo ProductUomConversion[] @relation("ProductUomConversionToUom")
  transformationOutputs MaterialTransformation[] @relation("TransformationOutputUom")
  transformationInputs MaterialTransformationInput[] @relation("TransformationInputUom")
  outboundTasks OutboundTask[]

  @@index([isActive])
  @@map("unit_of_measures")
}

model ProductUomConversion {
  id          String   @id @default(uuid())
  productId   String   @map("product_id")
  fromUomId   String   @map("from_uom_id")
  toUomId     String   @map("to_uom_id")
  factor      Decimal  @db.Decimal(18, 6)
  isActive    Boolean  @default(true) @map("is_active")
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  product     Product  @relation(fields: [productId], references: [id])
  fromUom     UnitOfMeasure @relation("ProductUomConversionFromUom", fields: [fromUomId], references: [id])
  toUom       UnitOfMeasure @relation("ProductUomConversionToUom", fields: [toUomId], references: [id])

  @@unique([productId, fromUomId, toUomId])
  @@index([productId, isActive])
  @@index([fromUomId])
  @@index([toUomId])
  @@map("product_uom_conversions")
}

model Supplier {
  id          String   @id @default(uuid())
  customerId  String   @map("customer_id")
  code        String
  name        String
  phone       String?  @map("phone")
  address     String?  @map("address") @db.Text
  province    String?  @map("province")
  city        String?  @map("city")
  district    String?  @map("district")
  subdistrict String?  @map("subdistrict")
  postalCode  String?  @map("postal_code")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  customer    Customer @relation(fields: [customerId], references: [id])
  productMappings ProductSupplier[]
  inboundItems InboundAsnItem[]
  pics        SupplierPic[]

  @@unique([customerId, code])
  @@index([customerId, isActive])
  @@map("suppliers")
}

model SupplierPic {
  id         String   @id @default(uuid())
  supplierId String   @map("supplier_id")
  name       String
  phone      String?  @map("phone")
  email      String?  @map("email")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId, sortOrder])
  @@map("supplier_pics")
}

model ProductSupplier {
  id         String   @id @default(uuid())
  productId  String   @map("product_id")
  supplierId String   @map("supplier_id")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  product    Product  @relation(fields: [productId], references: [id])
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  @@unique([productId, supplierId])
  @@index([productId, isActive])
  @@index([supplierId, isActive])
  @@map("product_suppliers")
}

model InventoryBalance {
  id          String       @id @default(uuid())
  customerId  String       @map("customer_id")
  warehouseId String       @map("warehouse_id")
  binId       String       @map("bin_id")
  productId   String       @map("product_id")
  qtyOnHand   Decimal      @default(0) @map("qty_on_hand") @db.Decimal(18, 4)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  customer    Customer     @relation(fields: [customerId], references: [id])
  warehouse   Warehouse    @relation(fields: [warehouseId], references: [id])
  bin         WarehouseBin @relation(fields: [binId], references: [id])
  product     Product      @relation(fields: [productId], references: [id])

  @@unique([customerId, warehouseId, binId, productId])
  @@index([warehouseId])
  @@index([binId])
  @@index([productId])
  @@map("inventory_balances")
}

model InternalTransfer {
  id              String                 @id @default(uuid())
  transferNo      String                 @unique @map("transfer_no")
  customerId      String                 @map("customer_id")
  fromWarehouseId String                 @map("from_warehouse_id")
  toWarehouseId   String                 @map("to_warehouse_id")
  status          InternalTransferStatus @default(DRAFT)
  note            String?
  completedAt     DateTime?              @map("completed_at")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  customer        Customer               @relation(fields: [customerId], references: [id])
  fromWarehouse   Warehouse              @relation("TransferFromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouse     Warehouse              @relation("TransferToWarehouse", fields: [toWarehouseId], references: [id])
  lines           InternalTransferLine[]
  eventLogs       ProcessFlowEventLog[]

  @@index([customerId, status])
  @@index([fromWarehouseId, status])
  @@index([toWarehouseId, status])
  @@map("internal_transfers")
}

model InternalTransferLine {
  id                 String           @id @default(uuid())
  transferId         String           @map("transfer_id")
  productId          String           @map("product_id")
  sourceBinId        String           @map("source_bin_id")
  destinationBinId   String           @map("destination_bin_id")
  qty                Decimal          @db.Decimal(18, 4)
  uomId              String?          @map("uom_id")
  qtyBase            Decimal?         @map("qty_base") @db.Decimal(18, 4)
  conversionFactor   Decimal?         @map("conversion_factor") @db.Decimal(18, 6)
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  transfer           InternalTransfer @relation(fields: [transferId], references: [id])
  product            Product          @relation(fields: [productId], references: [id])
  sourceBin          WarehouseBin     @relation("TransferLineSourceBin", fields: [sourceBinId], references: [id])
  destinationBin     WarehouseBin     @relation("TransferLineDestinationBin", fields: [destinationBinId], references: [id])
  uom                UnitOfMeasure?   @relation(fields: [uomId], references: [id])

  @@index([transferId])
  @@index([productId])
  @@index([uomId])
  @@map("internal_transfer_lines")
}

model MaterialTransformation {
  id                String                       @id @default(uuid())
  processNo         String                       @unique @map("process_no")
  customerId        String                       @map("customer_id")
  warehouseId       String                       @map("warehouse_id")
  outputProductId   String                       @map("output_product_id")
  outputBinId       String                       @map("output_bin_id")
  qtyOutput         Decimal                      @map("qty_output") @db.Decimal(18, 4)
  outputUomId       String?                      @map("output_uom_id")
  qtyOutputInput    Decimal?                     @map("qty_output_input") @db.Decimal(18, 4)
  outputConversionFactor Decimal?                @map("output_conversion_factor") @db.Decimal(18, 6)
  outputLotNo       String?                      @map("output_lot_no")
  outputBatchNo     String?                      @map("output_batch_no")
  outputSerialNos   Json?                        @map("output_serial_nos")
  status            MaterialTransformationStatus @default(DRAFT)
  note              String?
  completedAt       DateTime?                    @map("completed_at")
  createdAt         DateTime                     @default(now()) @map("created_at")
  updatedAt         DateTime                     @updatedAt @map("updated_at")
  customer          Customer                     @relation(fields: [customerId], references: [id])
  warehouse         Warehouse                    @relation(fields: [warehouseId], references: [id])
  outputProduct     Product                      @relation("TransformationOutputProduct", fields: [outputProductId], references: [id])
  outputBin         WarehouseBin                 @relation("TransformationOutputBin", fields: [outputBinId], references: [id])
  outputUom         UnitOfMeasure?               @relation("TransformationOutputUom", fields: [outputUomId], references: [id])
  recipeId          String?                      @map("recipe_id")
  recipe            ProcessRecipe?               @relation(fields: [recipeId], references: [id])
  inputs            MaterialTransformationInput[]
  eventLogs         ProcessFlowEventLog[]

  @@index([customerId, status])
  @@index([warehouseId, status])
  @@index([outputUomId])
  @@map("material_transformations")
}

model ProcessRecipe {
  id              String            @id @default(uuid())
  recipeCode      String            @map("recipe_code")
  customerId      String            @map("customer_id")
  outputProductId String            @map("output_product_id")
  baseOutputQty   Decimal           @map("base_output_qty") @db.Decimal(18, 4)
  isActive        Boolean           @default(true) @map("is_active")
  note            String?
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  customer        Customer          @relation(fields: [customerId], references: [id])
  outputProduct   Product           @relation("RecipeOutputProduct", fields: [outputProductId], references: [id])
  lines           ProcessRecipeLine[]
  transformations MaterialTransformation[]

  @@unique([customerId, recipeCode])
  @@index([customerId, isActive])
  @@index([outputProductId, isActive])
  @@map("process_recipes")
}

model ProcessRecipeLine {
  id         String        @id @default(uuid())
  recipeId   String        @map("recipe_id")
  productId  String        @map("product_id")
  qtyPerBase Decimal       @map("qty_per_base") @db.Decimal(18, 4)
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")
  recipe     ProcessRecipe @relation(fields: [recipeId], references: [id])
  product    Product       @relation(fields: [productId], references: [id])

  @@index([recipeId])
  @@index([productId])
  @@map("process_recipe_lines")
}

model MaterialTransformationInput {
  id                String                 @id @default(uuid())
  transformationId  String                 @map("transformation_id")
  productId         String                 @map("product_id")
  binId             String                 @map("bin_id")
  lotNo             String?                @map("lot_no")
  batchNo           String?                @map("batch_no")
  serialNos         Json?                  @map("serial_nos")
  qtyConsumed       Decimal                @map("qty_consumed") @db.Decimal(18, 4)
  uomId             String?                @map("uom_id")
  qtyConsumedInput  Decimal?               @map("qty_consumed_input") @db.Decimal(18, 4)
  conversionFactor  Decimal?               @map("conversion_factor") @db.Decimal(18, 6)
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")
  transformation    MaterialTransformation @relation(fields: [transformationId], references: [id])
  product           Product                @relation(fields: [productId], references: [id])
  bin               WarehouseBin           @relation(fields: [binId], references: [id])
  uom               UnitOfMeasure?         @relation("TransformationInputUom", fields: [uomId], references: [id])

  @@index([transformationId])
  @@index([productId])
  @@index([uomId])
  @@map("material_transformation_inputs")
}

model InboundAsn {
  id              String           @id @default(uuid())
  asnNo           String           @unique @map("asn_no")
  customerId      String           @map("customer_id")
  warehouseId     String           @map("warehouse_id")
  referenceNo     String?          @map("reference_no")
  status          InboundAsnStatus @default(DRAFT)
  expectedAt      DateTime?        @map("expected_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  customer        Customer         @relation(fields: [customerId], references: [id])
  warehouse       Warehouse        @relation(fields: [warehouseId], references: [id])
  items           InboundAsnItem[]
  receipts        InboundReceipt[]

  @@index([customerId])
  @@index([warehouseId])
  @@index([status])
  @@map("inbound_asns")
}

model InboundAsnItem {
  id            String      @id @default(uuid())
  inboundAsnId  String      @map("inbound_asn_id")
  productId     String      @map("product_id")
  supplierId    String      @map("supplier_id")
  uomId         String      @map("uom_id")
  qtyExpected   Decimal     @map("qty_expected") @db.Decimal(18, 4)
  qtyReceived   Decimal     @default(0) @map("qty_received") @db.Decimal(18, 4)
  qtyExpectedBase Decimal   @default(0) @map("qty_expected_base") @db.Decimal(18, 4)
  qtyReceivedBase Decimal   @default(0) @map("qty_received_base") @db.Decimal(18, 4)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  inboundAsn    InboundAsn  @relation(fields: [inboundAsnId], references: [id])
  product       Product     @relation(fields: [productId], references: [id])
  supplier      Supplier    @relation(fields: [supplierId], references: [id])
  uom           UnitOfMeasure @relation(fields: [uomId], references: [id])
  receipts      InboundReceipt[]

  @@unique([inboundAsnId, productId, supplierId])
  @@index([productId])
  @@index([supplierId])
  @@index([uomId])
  @@map("inbound_asn_items")
}

model InboundReceipt {
  id             String         @id @default(uuid())
  inboundAsnId   String         @map("inbound_asn_id")
  inboundItemId  String?        @map("inbound_item_id")
  customerId     String         @map("customer_id")
  warehouseId    String         @map("warehouse_id")
  binId          String         @map("bin_id")
  productId      String         @map("product_id")
  uomId          String         @map("uom_id")
  qtyReceived    Decimal        @map("qty_received") @db.Decimal(18, 4)
  qtyReceivedInput Decimal?     @map("qty_received_input") @db.Decimal(18, 4)
  conversionFactor Decimal?     @map("conversion_factor") @db.Decimal(18, 6)
  lotNo          String?        @map("lot_no")
  batchNo        String?        @map("batch_no")
  serialNos      Json?          @map("serial_nos")
  expiryDate     DateTime?      @map("expiry_date")
  note           String?
  receivedAt     DateTime       @default(now()) @map("received_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  inboundAsn     InboundAsn     @relation(fields: [inboundAsnId], references: [id])
  inboundItem    InboundAsnItem? @relation(fields: [inboundItemId], references: [id])
  customer       Customer       @relation(fields: [customerId], references: [id])
  warehouse      Warehouse      @relation(fields: [warehouseId], references: [id])
  bin            WarehouseBin   @relation(fields: [binId], references: [id])
  product        Product        @relation(fields: [productId], references: [id])
  uom            UnitOfMeasure  @relation(fields: [uomId], references: [id])

  @@index([inboundAsnId])
  @@index([customerId])
  @@index([warehouseId])
  @@index([binId])
  @@index([productId])
  @@index([uomId])
  @@map("inbound_receipts")
}

model SalesOrder {
  id            String           @id @default(uuid())
  orderNo       String           @unique @map("order_no")
  customerId    String           @map("customer_id")
  warehouseId   String           @map("warehouse_id")
  consigneeName String?          @map("consignee_name")
  referenceNo   String?          @map("reference_no")
  status        SalesOrderStatus @default(DRAFT)
  requestedAt   DateTime?        @map("requested_at")
  shippedAt     DateTime?        @map("shipped_at")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  customer      Customer         @relation(fields: [customerId], references: [id])
  warehouse     Warehouse        @relation(fields: [warehouseId], references: [id])
  items         SalesOrderItem[]
  waves         OutboundWave[]
  tasks         OutboundTask[]
  allocations   OutboundAllocation[]
  serialReservations OutboundSerialReservation[]
  eventLogs     OutboundEventLog[]

  @@index([customerId, status])
  @@index([warehouseId, status])
  @@map("sales_orders")
}

model SalesOrderItem {
  id           String     @id @default(uuid())
  salesOrderId String     @map("sales_order_id")
  productId    String     @map("product_id")
  qtyOrdered   Decimal    @map("qty_ordered") @db.Decimal(18, 4)
  qtyPicked    Decimal    @default(0) @map("qty_picked") @db.Decimal(18, 4)
  qtyPacked    Decimal    @default(0) @map("qty_packed") @db.Decimal(18, 4)
  qtyShipped   Decimal    @default(0) @map("qty_shipped") @db.Decimal(18, 4)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id])
  product      Product    @relation(fields: [productId], references: [id])
  tasks        OutboundTask[]
  allocations  OutboundAllocation[]
  serialReservations OutboundSerialReservation[]

  @@unique([salesOrderId, productId])
  @@index([productId])
  @@map("sales_order_items")
}

model OutboundAllocation {
  id              String         @id @default(uuid())
  salesOrderId    String         @map("sales_order_id")
  salesOrderItemId String        @map("sales_order_item_id")
  customerId      String         @map("customer_id")
  warehouseId     String         @map("warehouse_id")
  productId       String         @map("product_id")
  binId           String         @map("bin_id")
  qtyAllocated    Decimal        @map("qty_allocated") @db.Decimal(18, 4)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  salesOrder      SalesOrder     @relation(fields: [salesOrderId], references: [id])
  salesOrderItem  SalesOrderItem @relation(fields: [salesOrderItemId], references: [id])
  customer        Customer       @relation(fields: [customerId], references: [id])
  warehouse       Warehouse      @relation(fields: [warehouseId], references: [id])
  product         Product        @relation(fields: [productId], references: [id])
  bin             WarehouseBin   @relation(fields: [binId], references: [id])

  @@index([salesOrderId, salesOrderItemId])
  @@index([warehouseId, productId, binId])
  @@index([customerId, createdAt])
  @@map("outbound_allocations")
}

model OutboundWave {
  id           String     @id @default(uuid())
  waveNo       String     @unique @map("wave_no")
  salesOrderId String     @map("sales_order_id")
  warehouseId  String     @map("warehouse_id")
  plannedAt    DateTime?  @map("planned_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id])
  warehouse    Warehouse  @relation(fields: [warehouseId], references: [id])
  tasks        OutboundTask[]
  serialReservations OutboundSerialReservation[]

  @@index([salesOrderId])
  @@index([warehouseId])
  @@map("outbound_waves")
}

model OutboundTask {
  id              String             @id @default(uuid())
  salesOrderId    String             @map("sales_order_id")
  salesOrderItemId String            @map("sales_order_item_id")
  waveId          String?            @map("wave_id")
  warehouseId     String             @map("warehouse_id")
  productId       String             @map("product_id")
  sourceBinId     String?            @map("source_bin_id")
  taskType        OutboundTaskType   @map("task_type")
  status          OutboundTaskStatus @default(OPEN)
  qtyTask         Decimal            @map("qty_task") @db.Decimal(18, 4)
  uomId           String?            @map("uom_id")
  qtyTaskInput    Decimal?           @map("qty_task_input") @db.Decimal(18, 4)
  conversionFactor Decimal?          @map("conversion_factor") @db.Decimal(18, 6)
  qtyDone         Decimal            @default(0) @map("qty_done") @db.Decimal(18, 4)
  serialNos       Json?              @map("serial_nos")
  assignedTo      String?            @map("assigned_to")
  completedAt     DateTime?          @map("completed_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  salesOrder      SalesOrder         @relation(fields: [salesOrderId], references: [id])
  salesOrderItem  SalesOrderItem     @relation(fields: [salesOrderItemId], references: [id])
  wave            OutboundWave?      @relation(fields: [waveId], references: [id])
  warehouse       Warehouse          @relation(fields: [warehouseId], references: [id])
  product         Product            @relation(fields: [productId], references: [id])
  uom             UnitOfMeasure?     @relation(fields: [uomId], references: [id])
  sourceBin       WarehouseBin?      @relation("OutboundSourceBin", fields: [sourceBinId], references: [id])
  eventLogs       OutboundEventLog[]
  serialReservations OutboundSerialReservation[]

  @@index([salesOrderId, taskType, status])
  @@index([salesOrderItemId])
  @@index([waveId])
  @@index([warehouseId])
  @@index([productId])
  @@index([uomId])
  @@index([sourceBinId])
  @@map("outbound_tasks")
}

model OutboundEventLog {
  id                String      @id @default(uuid())
  salesOrderId      String      @map("sales_order_id")
  outboundTaskId    String?     @map("outbound_task_id")
  warehouseId       String      @map("warehouse_id")
  customerId        String      @map("customer_id")
  operatorCompanyId String?     @map("operator_company_id")
  eventCode         String      @map("event_code")
  note              String?
  metadata          Json?
  createdAt         DateTime    @default(now()) @map("created_at")
  salesOrder        SalesOrder  @relation(fields: [salesOrderId], references: [id])
  outboundTask      OutboundTask? @relation(fields: [outboundTaskId], references: [id])
  warehouse         Warehouse   @relation(fields: [warehouseId], references: [id])
  customer          Customer    @relation(fields: [customerId], references: [id])
  operatorCompany   OperatorCompany? @relation(fields: [operatorCompanyId], references: [id])

  @@index([salesOrderId, createdAt])
  @@index([outboundTaskId, createdAt])
  @@index([warehouseId, createdAt])
  @@index([customerId, createdAt])
  @@map("outbound_event_logs")
}

model OutboundSerialReservation {
  id                String                          @id @default(uuid())
  salesOrderId      String                          @map("sales_order_id")
  salesOrderItemId  String                          @map("sales_order_item_id")
  waveId            String?                         @map("wave_id")
  outboundTaskId    String?                         @map("outbound_task_id")
  customerId        String                          @map("customer_id")
  warehouseId       String                          @map("warehouse_id")
  productId         String                          @map("product_id")
  serialNo          String                          @map("serial_no")
  status            OutboundSerialReservationStatus @default(ACTIVE)
  reservedAt        DateTime                        @default(now()) @map("reserved_at")
  consumedAt        DateTime?                       @map("consumed_at")
  releasedAt        DateTime?                       @map("released_at")
  releaseReason     String?                         @map("release_reason")
  createdAt         DateTime                        @default(now()) @map("created_at")
  updatedAt         DateTime                        @updatedAt @map("updated_at")
  salesOrder        SalesOrder                      @relation(fields: [salesOrderId], references: [id])
  salesOrderItem    SalesOrderItem                  @relation(fields: [salesOrderItemId], references: [id])
  wave              OutboundWave?                   @relation(fields: [waveId], references: [id])
  outboundTask      OutboundTask?                   @relation(fields: [outboundTaskId], references: [id])
  customer          Customer                        @relation(fields: [customerId], references: [id])
  warehouse         Warehouse                       @relation(fields: [warehouseId], references: [id])
  product           Product                         @relation(fields: [productId], references: [id])

  @@unique([customerId, productId, serialNo, status])
  @@index([salesOrderId, salesOrderItemId, status])
  @@index([waveId, status])
  @@index([outboundTaskId, status])
  @@index([warehouseId, productId, status])
  @@index([customerId, createdAt])
  @@map("outbound_serial_reservations")
}

model ProcessFlowEventLog {
  id                       String                  @id @default(uuid())
  eventCode                String                  @map("event_code")
  processType              String                  @map("process_type")
  customerId               String                  @map("customer_id")
  warehouseId              String                  @map("warehouse_id")
  operatorCompanyId        String?                 @map("operator_company_id")
  internalTransferId       String?                 @map("internal_transfer_id")
  materialTransformationId String?                 @map("material_transformation_id")
  note                     String?
  metadata                 Json?
  createdAt                DateTime                @default(now()) @map("created_at")
  customer                 Customer                @relation(fields: [customerId], references: [id])
  warehouse                Warehouse               @relation(fields: [warehouseId], references: [id])
  operatorCompany          OperatorCompany?        @relation(fields: [operatorCompanyId], references: [id])
  internalTransfer         InternalTransfer?       @relation(fields: [internalTransferId], references: [id])
  materialTransformation   MaterialTransformation? @relation(fields: [materialTransformationId], references: [id])

  @@index([customerId, createdAt])
  @@index([warehouseId, createdAt])
  @@index([internalTransferId, createdAt])
  @@index([materialTransformationId, createdAt])
  @@map("process_flow_event_logs")
}

model BillingContract {
  id              String      @id @default(uuid())
  customerId      String      @map("customer_id")
  contractNo      String      @map("contract_no")
  name            String
  periodStart     DateTime    @map("period_start")
  periodEnd       DateTime?   @map("period_end")
  currency        String      @default("IDR")
  billingCycleDay Int         @default(1) @map("billing_cycle_day")
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  customer        Customer    @relation(fields: [customerId], references: [id])
  rates           BillingRate[]

  @@unique([customerId, contractNo])
  @@index([customerId, isActive])
  @@map("billing_contracts")
}

model BillingRate {
  id           String           @id @default(uuid())
  contractId   String           @map("contract_id")
  component    BillingComponent
  activityCode String           @map("activity_code")
  uom          String
  rate         Decimal          @db.Decimal(18, 4)
  minCharge    Decimal?         @map("min_charge") @db.Decimal(18, 4)
  isActive     Boolean          @default(true) @map("is_active")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  contract     BillingContract  @relation(fields: [contractId], references: [id])

  @@unique([contractId, component, activityCode, uom])
  @@index([contractId, isActive])
  @@map("billing_rates")
}

model BillingTransaction {
  id                String                   @id @default(uuid())
  customerId        String                   @map("customer_id")
  warehouseId       String?                  @map("warehouse_id")
  operatorCompanyId String?                  @map("operator_company_id")
  component         BillingComponent
  activityCode      String                   @map("activity_code")
  uom               String
  qty               Decimal                  @db.Decimal(18, 4)
  amount            Decimal                  @db.Decimal(18, 4)
  referenceType     String?                  @map("reference_type")
  referenceId       String?                  @map("reference_id")
  periodKey         String                   @map("period_key")
  status            BillingTransactionStatus @default(DRAFT)
  occurredAt        DateTime                 @map("occurred_at")
  note              String?
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")
  customer          Customer                 @relation(fields: [customerId], references: [id])
  warehouse         Warehouse?               @relation(fields: [warehouseId], references: [id])
  operatorCompany   OperatorCompany?         @relation(fields: [operatorCompanyId], references: [id])

  @@index([customerId, periodKey, status])
  @@index([warehouseId])
  @@index([operatorCompanyId])
  @@index([occurredAt])
  @@map("billing_transactions")
}

