// SaaS control plane — schema `platform` only (separate Prisma Client).
// Generate: npm run prisma:generate:platform

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/platform-prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["platform"]
}

enum TenantStatus {
  PROVISIONING
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED

  @@schema("platform")
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED

  @@schema("platform")
}

enum PlatformRole {
  SUPER_ADMIN
  SUPPORT
  BILLING

  @@schema("platform")
}

enum ProvisioningJobStatus {
  PENDING
  RUNNING
  FAILED
  SUCCESS

  @@schema("platform")
}

enum ProvisioningStep {
  CREATE_SCHEMA
  MIGRATE
  SEED
  DONE

  @@schema("platform")
}

model Plan {
  id             String   @id @default(uuid())
  code           String   @unique @db.VarChar(64)
  name           String   @db.VarChar(200)
  maxWarehouses  Int      @default(1) @map("max_warehouses")
  maxUsers       Int      @default(5) @map("max_users")
  maxCustomers   Int      @default(10) @map("max_customers")
  features       Json     @default("{}")
  priceMonthly   Decimal  @default(0) @map("price_monthly") @db.Decimal(18, 2)
  sortOrder      Int      @default(0) @map("sort_order")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  tenants        Tenant[]
  subscriptions  TenantSubscription[]

  @@index([isActive])
  @@index([sortOrder])
  @@map("plans")
  @@schema("platform")
}

model Tenant {
  id                String             @id @default(uuid())
  slug              String             @unique @db.VarChar(64)
  schemaName        String             @unique @map("schema_name") @db.VarChar(80)
  name              String             @db.VarChar(200)
  status            TenantStatus       @default(PROVISIONING)
  planId            String?            @map("plan_id")
  trialEndsAt       DateTime?          @map("trial_ends_at")
  provisionedAt     DateTime?          @map("provisioned_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  plan              Plan?              @relation(fields: [planId], references: [id])
  subscription      TenantSubscription?
  provisioningJobs  TenantProvisioningJob[]
  auditLogs         PlatformAuditLog[]
  featureFlags      TenantFeatureFlag[]

  @@index([status])
  @@index([planId])
  @@map("tenants")
  @@schema("platform")
}

model TenantSubscription {
  id                 String             @id @default(uuid())
  tenantId           String             @unique @map("tenant_id")
  planId             String             @map("plan_id")
  status             SubscriptionStatus @default(TRIAL)
  trialEndsAt        DateTime?          @map("trial_ends_at")
  currentPeriodStart DateTime?          @map("current_period_start")
  currentPeriodEnd   DateTime?          @map("current_period_end")
  externalCustomerId String?            @map("external_customer_id") @db.VarChar(120)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan               Plan               @relation(fields: [planId], references: [id])

  @@index([planId])
  @@index([status])
  @@map("tenant_subscriptions")
  @@schema("platform")
}

model PlatformUser {
  id           String       @id @default(uuid())
  email        String       @unique @db.VarChar(320)
  passwordHash String       @map("password_hash")
  name         String?      @db.VarChar(200)
  role         PlatformRole @default(SUPPORT)
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  auditLogs    PlatformAuditLog[]

  @@index([isActive])
  @@map("platform_users")
  @@schema("platform")
}

model TenantProvisioningJob {
  id           String                @id @default(uuid())
  tenantId     String                @map("tenant_id")
  step         ProvisioningStep
  status       ProvisioningJobStatus @default(PENDING)
  error        String?               @db.Text
  attemptCount Int                   @default(0) @map("attempt_count")
  startedAt    DateTime?             @map("started_at")
  finishedAt   DateTime?             @map("finished_at")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")
  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([status])
  @@map("tenant_provisioning_jobs")
  @@schema("platform")
}

model PlatformAuditLog {
  id             String        @id @default(uuid())
  platformUserId String?       @map("platform_user_id")
  tenantId       String?       @map("tenant_id")
  action         String        @db.VarChar(120)
  metadata       Json          @default("{}")
  createdAt      DateTime      @default(now()) @map("created_at")
  platformUser   PlatformUser? @relation(fields: [platformUserId], references: [id])
  tenant         Tenant?       @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([platformUserId, createdAt(sort: Desc)])
  @@map("platform_audit_logs")
  @@schema("platform")
}

model PlatformSetting {
  key       String   @id @db.VarChar(120)
  value     Json     @default("{}")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
  @@schema("platform")
}

model TenantFeatureFlag {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  flagKey   String   @map("flag_key") @db.VarChar(120)
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, flagKey])
  @@map("tenant_feature_flags")
  @@schema("platform")
}
